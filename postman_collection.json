						"url": {
							"raw": "http://localhost:8085/api/payments/process",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8085",
							"path": ["api", "payments", "process"]
						},
						"description": "Mock payment processor generating unique transaction reference."
					}
				},
				{
					"name": "Get Payment By Order ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8085/api/payments/order/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8085",
							"path": ["api", "payments", "order", "1"]
						},
						"description": "Retrieves the payment transaction associated with Order 1."
					}
				},
				{
					"name": "Get All Payments",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8085/api/payments",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8085",
